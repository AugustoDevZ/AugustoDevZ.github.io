---
import Group from "../components/group.astro";
---

<section class="group-content">
    <Group
        title="Zrute "
        text="Una app web dedicada a el trazo de rutas de medios de transporte cerca de ti y de tu destino en la ciudad de Trujillo - Perú"
        link="/portafolio/zrute"
        info1="Web App"
        info2="Maps App"
        info3="Private project"
        color1="#42658f"
        color2="#278883"
        colorBorderHover="#2f4267"
        colorBorder="#242d4d"
    />
    <Group
        title="ScanEx "
        text="Una app para escritorio dedicado a la búsqueda optimizada de datos en archivos de bases de datos.txt  y personalización de búsqueda con regex."
        link="/portafolio/ScanEx"
        info1="Windows App"
        info2="External API"
        info3="Public project"
        color1="#3E42A0"
        color2="#2B53A7"
        colorBorderHover="#1D3872"
        colorBorder="#242d4d"
    />
    <Group
        title="Zadints Bot"
        text="Un bot de discord de alto rendimiento. Cuente con opciones de personalizacion completa y sistema antiraid básico para brindar seguridad y orden en tu servidor"
        link="/portafolio/zadints-bot"
        info1="Bot App"
        info2="Internal Llibrary"
        info3="Public project"
        color1="#966622"
        color2="#687188"
        colorBorderHover="#664521"
        colorBorder="#31242A"
    />
    <Group
        title="Zadints Tech"
        text="Una plataforma para laa presentacion de la marca Zadints y sus productos en general."
        link="/portafolio/zadints-web"
        info1="Web App"
        info2="API Zadints"
        info3="Public private"
        color1="#EA5A0C"
        color2="#F29A0B"
        colorBorderHover="#5E2717"
        colorBorder="#2E1924"
    />
</section>

<style>
    .group-content {
        display: flex;
        flex-wrap: wrap;
        justify-content: start;
        align-items: center;
        gap: 1rem;
    }
</style>

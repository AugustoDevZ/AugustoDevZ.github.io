---
import Group from "../components/group.astro";
---

<section class="group-content">
    
    <Group
        title="ScanEx "
        text="Una app para escritorio dedicado a la búsqueda optimizada de datos en archivos .txt como Logs,Bases de datos, etc.  y personalización de búsqueda con regex."
        link="/portafolio/ScanEx"
        info1="Windows App"
        info2="External API"
        info3="Public project"
        color1="#3E42A0"
        color2="#2B53A7"
        colorBorderHover="#1D3872"
        colorBorder="#242d4d"
    />
    <Group
        title="Zadints Bot"
        text="Un bot de discord de alto rendimiento. Cuente con opciones de personalizacion completa y sistema antiraid básico para brindar seguridad y orden en tu servidor"
        link="/portafolio/zadints-bot"
        info1="Bot App"
        info2="Internal Llibrary"
        info3="Public project"
        color1="#966622"
        color2="#687188"
        colorBorderHover="#664521"
        colorBorder="#31242A"
    />
    
    <Group
        title="Portafolio Web"
        text="Una app web estática creada con Astro. Esta página muestra la experiencia recaudada e importante."
        link="/portafolio/portafolio"
        info1="Web App"
        info2="SSG"
        info3="Public project"
        color1="#5A67F9"
        color2="#7069F6"
        colorBorderHover="#3B2A70"
        colorBorder="#201948"
    />
    <Group
        title="UI Model_1"
        text="Diseño front UI/UX para una app de escritorio echa en WPF. Esta app cuenta con varias tonalidades (Clic para ver más)"
        link="/portafolio/ui-model"
        info1="Windows App"
        info2="External API"
        info3="Public project"
        color1="#1E3D8C"
        color2="#08AFD0"
        colorBorderHover="#111C46"
        colorBorder="#141F50"
    />
</section>

<style>
    .group-content {
        display: flex;
        width: 100%;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 1rem;

    }
</style>

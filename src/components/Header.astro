<header class="header">
    <h1 class="header-perfil">César Augusto</h1>

    <ul class="header-links" id="menu">
        <li><a class="al" href="/">Portafolio</a></li>
        <li><a class="al" href="/sobre-mi">Sobre mi</a></li>
        <li><a class="al" href="/">Testimonios</a></li>
        <li><a class="al" href="/contacto">Contacto</a></li>
        <li>
            <a class="button-type" href="CV_Augusto.pdf" download
                >Descargar CV</a
            >
        </li>
    </ul>
    <button class="menu-btn" id="menuBtn"> ☰ </button>
</header>
<script>

    document.addEventListener("click", (e) => {
        const menu = document.getElementById("menu");
        const menuBtn = document.getElementById("menuBtn");

        if (!menu || !menuBtn) return;
        if (!(e.target instanceof Node)) return;

        const target = e.target as Node;

        if (menuBtn.contains(target)) {
            menu.classList.toggle("active");
            return;
        }
        if (menu.contains(target)) {
            const link = (target as HTMLElement).closest("a");
            if (link) {
                menu.classList.remove("active");
            }
        } else {
            menu.classList.remove("active");
        }
    });
</script>
<style>
    .al {
        cursor: pointer;
    }
    ul {
        list-style: none;
    }

    .button-type {
        background: #111133;
        border: 1px solid #363669;
        padding: 0.4rem;
        padding-left: 1.5rem;
        padding-right: 1.5rem;
        border-radius: 14px;
        text-decoration: none;
        color: #ffffff;
        font-weight: 600;
        margin: 0; 
    }

    .button-type:hover {
        background-color: #02c1ab18;
    }

    .header {
        width: 100%;
        max-width: 2560px;
        position: fixed;
        background-color: #0d0d2785;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        border-bottom: 2px solid #1b1b42;
        backdrop-filter: blur(2px);
        z-index: 100;
        font-size: 14px;
    }

    .header-perfil {
        color: white;
        padding-left: 5.5rem;
        padding-right: 5.5rem;
        font-size: 16px;
        font-weight: 600;
        max-width: 50%;
        width: 40%;
    }

    .header-links {
        display: flex;
        gap: 1rem;
        max-width: 50%;
        width: 40%;
        justify-content: center;
   
    }

    .header-links a {
        text-decoration: none;
        color: #625e8d;
        font-size: 13px;
        transition: color 0.2s ease;
    }

    .header-links a:hover {
        color: #02c1ab;
    }

    .menu-btn {
        display: none;
        background: transparent;
        border: none;
        color: #7777aa;
        font-size: 2rem;
        cursor: pointer;
    }

    @media (max-width: 768px) {
        .header {
            justify-content: space-between;
            height: 7rem;
            max-height: 7rem;
        }

        .menu-btn {
            display: block;
            padding-right: 3rem;
        }

        .header-links {
            position: absolute;
            top: 100%;
            left: 0;

            width: 100%;
            background: #111133;

            flex-direction: column;
            align-items: center;

            padding: 1rem 0;
            display: none;
        }

        .header-links.active {
            display: flex;
        }

        
    }
</style>

---
const { textContent, oneTitle, twoTitle } = Astro.props;
---

<div class="absolute-line-content">
    <div class="absolute-line">
        <div class="content-line">
            <div class="line"></div>
        </div>
        <div class="text">
            <h2 class="title">
                <span class="font">{oneTitle}</span>
                <span class="font-rgb">{twoTitle}</span>
            </h2>

            <h3
                class="description"
                style="--color: #6d6da0; --font-size: 16px;"
            >
                {textContent}
            </h3>
        </div>
    </div>
</div>

<style>
    .absolute-line-content{
        width: 100%;
        display: flex;
        justify-content: center;
    }
    .absolute-line {
        width: 100%;
        max-width: 2560px;
        flex-wrap: wrap;
        display: flex;
        justify-content: center;
    }
    :root {
        --color: white;
        --font-size: 3rem;
    }

    .text {
        width: 100%;
        max-width: 2060px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.8rem;
    }

    .title {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin: 0;
        line-height: 1.1;
    }

    .font {
        color: var(--color);
        font-size: var(--font-size);
        margin: 0;
    }

    .font-rgb {
        background: linear-gradient(90deg, #38bdf8, #818cf8, #c084fc);

        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;

        font-size: var(--font-size);
        margin: 0;
    }

    .description {
        color: var(--color);
        font-size: var(--font-size);
        font-weight: 400;
        width: 80%;
        margin: 0;
    }

    .content-line {
        width: 100%;
        max-width: 2060px;
        margin-top: 4rem;
        margin-bottom: 7rem;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    .line {
        width: 20%;
        height: 2px;
        background: linear-gradient(
            135deg,
            #584bbe00,
            #584bbe,
            rgb(0, 255, 170),
            #584bbe,
            #584bbe00
        );
    }

    @media (max-width: 768px) {
        .line {
            width: 50%;
        }

        .text {
            text-align: center;
            width: 100%;
        }

        .description {
            text-align: center;
            width: 100%;
        }
    }
</style>

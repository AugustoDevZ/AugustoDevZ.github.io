---
interface Props {
    Title: string;
    tag1: string;
    tag2: string;
    tag3: string;
    context: string;
    reto: string;
    solution: string;
    result: string;
    stack: string[];
    role: string;
    img: string[];
    link: string;
}

const { Title, tag1, tag2, tag3, context, reto, solution, result, role, img , link} =
    Astro.props;

const { stack = [] } = Astro.props;
---

<div class="project-card">
    <div class="project-header">
        <h1>{Title}</h1>

        <div class="tags">
            <span>{tag1}</span>
            <span>{tag2}</span>
            <span>{tag3}</span>
        </div>
    </div>

    <div class="project-grid">
        <div class="left-content">
            <div class="section">
                <h3>◌ CONTEXTO</h3>
                <p>
                    {context}
                </p>
            </div>

            <div class="section challenge">
                <h3>◎ EL RETO</h3>

                <div class="challenge-box">
                    <p>
                        {reto}
                    </p>
                </div>
            </div>

            <div class="section solution">
                <h3>◉ LA SOLUCIÓN</h3>

                <div class="solution-box">
                    <p>
                        {solution}
                    </p>
                </div>
            </div>

            <div class="section results">
                <h3>↗ RESULTADOS</h3>

                <p>
                    {result}
                </p>
            </div>
        </div>

        <div class="right-content">
            <div class="stack-box">
                <h4>STACK TÉCNICO</h4>

                <div class="stack-tags">
                    {stack.map((item) => <span>{item}</span>)}
                </div>

                <div class="role">
                    <p>Mi Rol:</p>
                    <strong>{role}</strong>
                </div>
            </div>

            {
                img?.length > 0 && (
                    <div class="gallery">
                        <h4>GALERÍA DEL PROYECTO</h4>

                        {img.map((item) => (
                            <div class="gallery-image">
                                <img src={item} alt="" />
                            </div>
                        ))}
                    </div>
                )
            }
            
            <a class="stats" href={link}><div>Visita Proyecto</div></a>
        </div>
    </div>
</div>

<style>
    body {
        background: #030512;
        font-family: sans-serif;
        padding: 2rem;
    }

    .project-card {
        max-width: 1000px;
        margin: 2rem;

        background: linear-gradient(180deg, #060b22, #040816);

        border: 1px solid rgba(77, 145, 255, 0.2);

        border-radius: 24px;

        padding: 2rem;

        color: white;

        box-shadow:
            0 0 80px rgba(0, 153, 255, 0.08),
            inset 0 0 40px rgba(0, 119, 255, 0.05);
    }

    .project-header {
        display: flex;
        align-items: center;
        gap: 1rem;

        margin-bottom: 2rem;
    }

    .icon-box {
        width: 55px;
        height: 55px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 14px;

        background: rgba(63, 124, 255, 0.08);

        color: #69d2ff;

        border: 1px solid rgba(105, 210, 255, 0.2);
    }

    .project-header h1 {
        margin: 0;
        font-size: 2rem;

        color: #67d4ff;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;

        margin-top: 0.5rem;
    }

    .tags span,
    .stack-tags span {
        padding: 0.35rem 0.8rem;

        border-radius: 999px;

        font-size: 0.7rem;

        border: 1px solid rgba(119, 179, 255, 0.15);

        background: rgba(255, 255, 255, 0.03);

        color: #8ed8ff;
    }

    .stats {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;

        margin-bottom: 2rem;
    }

    .stat-box {
        border: 1px solid rgba(106, 170, 255, 0.15);

        border-radius: 14px;

        padding: 1.4rem;

        background: rgba(255, 255, 255, 0.02);

        text-align: center;
    }

    .stat-box h2 {
        margin: 0;

        color: #00ffd0;

        font-size: 2rem;
    }

    .stat-box p {
        margin-top: 0.5rem;

        font-size: 0.75rem;

        letter-spacing: 1px;

        color: #7d8ca5;
    }

    .project-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 2rem;
    }

    .section {
        margin-bottom: 2rem;
    }

    .section h3,
    .stack-box h4,
    .gallery h4 {
        font-size: 0.85rem;

        letter-spacing: 2px;

        margin-bottom: 1rem;
    }

    .section p {
        line-height: 1.8;

        color: #98a8c5;
    }

    .challenge h3 {
        color: #ff4f9f;
    }

    .solution h3 {
        color: #1cf2d0;
    }

    .results h3 {
        color: #5fff9f;
    }

    .challenge-box,
    .solution-box {
        padding: 1rem;

        border-radius: 14px;

        background: rgba(255, 255, 255, 0.03);

        border: 1px solid rgba(255, 255, 255, 0.06);
    }

    .challenge-box {
        border-left: 3px solid #ff2e88;
    }

    .solution-box {
        border-left: 3px solid #00ffd0;
    }

    .stack-box {
        border: 1px solid rgba(120, 170, 255, 0.15);

        border-radius: 18px;

        padding: 1.2rem;

        background: rgba(255, 255, 255, 0.02);

        margin-bottom: 2rem;
    }

    .stack-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;

        margin-bottom: 1.5rem;
    }

    .role p {
        color: #7f91b1;

        margin-bottom: 0.3rem;
    }

    .gallery-image {
        width: 100%;
        height: 160px;
        margin-top: 1rem;
        border-radius: 14px;

        background: linear-gradient(
            135deg,
            rgba(0, 255, 255, 0.1),
            rgba(140, 0, 255, 0.1)
        );

        border: 1px solid rgba(255, 255, 255, 0.08);
        overflow: hidden;
    }

    .gallery-image img {
        width: 100%;
        height: 160px;
    }

    @media (max-width: 900px) {
        .project-grid {
            grid-template-columns: 1fr;
        }

        .stats {
            grid-template-columns: 1fr;
        }
    }
</style>

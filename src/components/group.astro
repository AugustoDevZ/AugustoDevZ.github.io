---
const {
    title,
    text,
    link,
    info1,
    info2,
    info3,
    color1,
    color2,
    colorBorderHover,
    colorBorder,
} = Astro.props;
---

<a
    class="group"
    href={link}
    style={`
        --color1:${color1};
        --color2:${color2};
        --color-border-hover:${colorBorderHover};
        --color-border:${colorBorder}`}
>
    <h2 class="group-title">{title}</h2>
    <h3 class="group-text">{text}</h3>
    <i class="fa-solid fa-arrow-up-right-from-square"></i>

    <div class="group-info-all">
        <span class="group-info">{info1}</span>
        <span class="group-info">{info2}</span>
        <span class="group-info">{info3}</span>
    </div>
</a>
<style>
    a {
        text-decoration: none;
    }

    :root {
        --color1: #42658f;
        --color2: #278883;
        --color-border-hover: #2f4267;
        --color-border: #242d4d;
        --font-color: #4f507b;
    }
    .group-info-all {
        flex: 1;
        color: var(--color2);
        height: auto;
        margin-top: 2rem;
        font-size: 10px;
        display: flex;
        gap: 0.5rem;
        justify-content: start;
        align-items: flex-end;
    }
    .group-info {
        padding: 0.4rem;
        border-radius: 15px;
        background-color: #242d4d31;
        border: 1px solid var(--color-border);
    }

    .fa-solid {
        color: var(--font-color);
    }
    .group-title {
        background: linear-gradient(
            90deg,
            color-mix(in srgb, var(--color1) 85%, rgb(255, 255, 255)),
            color-mix(in srgb, var(--color2) 85%, rgb(255, 255, 255))
        );
        filter: saturate(2);
        border-radius: 8px;
        color: white;
        font-size: 1.3rem;

        padding: 0.2rem;
        padding-left: 0.8rem;
    }
    .group-text,
    a {
        color: var(--font-color);
        font-size: 0.8rem;
        font-weight: lighter;
        color: var(--font-color);
    }

    .group {
        position: relative;
        max-width: 21rem;
        min-height: 15rem;
        margin-top: 1rem;
        background-color: #0d0d2588;
        padding: 1rem;
        border-radius: 16px;
        border: 1px solid var(--color-border);
        overflow: hidden;
        transition: all 0.2s ease;
    }
    .group:hover {
        box-shadow: 0 0 5mm #0c4f523a;
        transform: translateY(-5px);
        border-color: var(--color-border-hover);
    }

    .group::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background: linear-gradient(90deg, var(--color1), var(--color2));
    }

    /*animation: pulso-luz 2s infinite alternate;*/

    @keyframes pulso-luz {
        0% {
            box-shadow: 0 0 10px #0c4f525e;
        }
        50% {
            box-shadow: 0 0 30px #14757a69;
        }
        100% {
            box-shadow: 0 0 10px #29afb641;
        }
    }

    @media (max-width: 768px) {
        .group {
            max-width: 34rem;
        }

        .group-title {
            font-size: 2rem;
        }

        .group-text,
        a {
            font-size: 1rem;
        }

        .group-info-all {

            font-size: 15px;

        }
    }
</style>
